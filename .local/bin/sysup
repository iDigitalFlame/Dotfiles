# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.
#

set -uo pipefail

if [ -f "${HOME}/.local/apps/updateHosts/updateHostsFile.py" ]; then
    if ! dash -c "cd '${HOME}/.local/apps/updateHosts'; /usr/bin/ghr firewall-web /usr/bin/dash -c 'git pull 2> /dev/null' | grep -q 'Already up to date'"; then
        printf "\x1b[93m\x1b[1mGrabbing updates to codebase...\x1b[0m\n"
        /usr/bin/ghr firewall-web /usr/bin/dash -c "cd '${HOME}/.local/apps/updateHosts'; git stash 1> /dev/null 2> /dev/null; git pull -q 1> /dev/null 2> /dev/null"
    fi
    printf "\x1b[93m\x1b[1mUpdating hosts blocklist file..\x1b[0m\n"
    cat<<EOF | /usr/bin/ghr firewall-web /usr/bin/dash
    cd "${HOME}/.local/apps/updateHosts"
    python3 -X pycache_prefix=/var/cache/python -OO ${HOME}/.local/apps/updateHosts/updateHostsFile.py --auto --compress --minimise --skipstatichosts
    git stash 1> /dev/null 2> /dev/null
EOF
    hosts="${HOME}/.local/apps/updateHosts/hosts"
else
    hosts=""
fi

localhost=$(
cat<<EOF
127.0.0.1 localhost
127.0.0.1 localhost.localdomain
127.0.0.1 local
::1 localhost
::1 ip6-localhost
::1 ip6-loopback
ff00::0 ip6-localnet
ff00::0 ip6-mcastprefix
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
ff02::3 ip6-allhosts

127.0.0.1 $(hostname)
127.0.0.1 cups
172.16.2.3 lszb1.losynth.com
EOF
)

blocked=$((
cat<<EOF | /usr/bin/ghr firewall-web /usr/bin/dash
curl -sL 'https://blocklistproject.github.io/Lists/facebook.txt'
curl -sL 'https://www.github.developerdan.com/hosts/lists/facebook-extended.txt'
curl -sL 'https://raw.githubusercontent.com/anudeepND/blacklist/master/facebook.txt'
curl -sL 'https://raw.githubusercontent.com/jmdugan/blocklists/master/corporations/facebook/all'
curl -sL 'https://raw.githubusercontent.com/jmdugan/blocklists/master/corporations/pinterest/all'
for i in \$(curl -sL 'https://raw.githubusercontent.com/nocturnalarchives/BlockLists/master/facebook-trackers.txt' | grep -v '^#'); do
    echo "0.0.0.0 \$i"
done
for i in \$(curl -sL 'https://raw.githubusercontent.com/krombopulosM/TikTok-blocklist/master/tiktok%20blocklist.txt' | grep -v '^#'); do
    echo "0.0.0.0 \$i"
done
EOF
cat<<EOF
0.0.0.0 www.facebook.com
0.0.0.0 facebook.com
0.0.0.0 login.facebook.com
0.0.0.0 www.login.facebook.com
0.0.0.0 fbcdn.net
0.0.0.0 www.fbcdn.net
0.0.0.0 fbcdn.com
0.0.0.0 www.fbcdn.com
0.0.0.0 static.ak.fbcdn.net
0.0.0.0 static.ak.connect.facebook.com
0.0.0.0 connect.facebook.net
0.0.0.0 www.connect.facebook.net
0.0.0.0 apps.facebook.com
::1 www.facebook.com
::1 facebook.com
::1 login.facebook.com
::1 www.login.facebook.com
::1 fbcdn.net
::1 www.fbcdn.net
::1 fbcdn.com
::1 www.fbcdn.com
::1 static.ak.fbcdn.net
::1 static.ak.connect.facebook.com
::1 connect.facebook.net
::1 www.connect.facebook.net
::1 apps.facebook.com
EOF
) | grep -vE '^#' | sort | uniq -u)

/usr/bin/ghr firewall-web /usr/bin/yay -Pw

printf "\x1b[96m\x1b[1mStarting pacman..\x1b[0m\n"
sudo dash -c 'mount -o rw,remount /; /usr/bin/env SYSBATCH=1 /usr/bin/sysupdate' || exit 1

if [ -n "$hosts" ]; then
    printf "\x1b[93m\x1b[1mAdding generated hosts!\x1b[0m\n"
    cat<<EOF | sudo -i --
mount -o rw,remount /
sync
echo "$localhost" > "/etc/hosts"
cat "$hosts" >> "/etc/hosts"
echo "$blocked" >> "/etc/hosts"
EOF
fi

printf "\x1b[96m\x1b[1mStarting yay..\x1b[0m\n"
if ! /usr/bin/ghr firewall-web /usr/bin/env SYSBATCH=1 PYTHONPYCACHEPREFIX=/var/cache/python PYTHONOPTIMIZE=2 /usr/bin/yay -Syua --answerclean N; then
    exit 1;
fi

printf "\x1b[96m\x1b[1mUpdating PIP packages...\x1b[0m\n"
cat<<EOF | /usr/bin/ghr firewall-web /usr/bin/dash
    export PIP_USER=yes
    export PYTHONOPTIMIZE=2
    export PYTHONPYCACHEPREFIX=/var/cache/python
    python3 -X pycache_prefix=/var/cache/python -OO /usr/bin/pip list --user --outdated --format=json | jq -r '.[] | (.name)' | xargs -n1 python3 -X pycache_prefix=/var/cache/python -OO /usr/bin/pip install --disable-pip-version-check --break-system-packages -U 2>&1 | grep -v 'least one requirement to install (see "pip help install")'
EOF

printf "\x1b[96m\x1b[1mUpdating Cargo packages...\x1b[0m\n"
/usr/bin/ghr firewall-web /usr/bin/cargo install-update --all

printf "\x1b[96m\x1b[1mUpdating Go packages...\x1b[0m\n"
/usr/bin/ghr firewall-all "${HOME}/.local/lib/go/bin/go-global-update" | grep -v 'up-to-date'

cat<<EOF | sudo -i --
    mount -o rw,remount /
    syslink
    mount -ro remount,ro / 2> /dev/null || mount -Rro remount,ro /
EOF
